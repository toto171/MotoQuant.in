# MotoQuant API — environment reference (copy to .env for local use; never commit secrets)
#
# EVERY variable here is OPTIONAL. With none of them set, `make api`
# (uvicorn motoquant.api:app) serves the full simulator, catalog, optimizer,
# leaderboard and optional accounts for local development.
# MotoQuant is free and open source (Apache-2.0): there is no billing,
# payment-provider or license-key configuration of any kind.
# Deployment walkthrough: docs/SELF_HOSTING.md

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the SQLite catalog. The repo ships a seeded motoquant.db.
# For durable accounts + saved runs on a host, point this at a persistent disk;
# docker-entrypoint.sh seeds it from the image copy on first boot.
# MOTOQUANT_DB=motoquant.db

# ── Deployment flag ──────────────────────────────────────────────────────────
# Render sets RENDER / RENDER_EXTERNAL_URL automatically. On ANY other host set
# MOTOQUANT_DEPLOYED=1 so the API (a) never echoes magic-link tokens in HTTP
# responses and (b) never signs sessions with the public dev JWT secret.
# MOTOQUANT_DEPLOYED=1

# ── Optional accounts (sign in to keep saved runs in a garage) ──────────────
# 32+ random bytes, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Unset on a deployed host → an EPHEMERAL per-process secret is used (secure,
# but every sign-in resets when the process restarts). Unset locally → the
# public dev default (fine for development only).
# JWT_SECRET=
# JWT_ALGORITHM=HS256
# Base URL used to build magic-link sign-in links.
# MOTOQUANT_BASE_URL=https://www.motoquant.in

# Magic-link email transport — derived from what is set (Resend > SMTP > stdout).
# Without either on a deployed host, magic-link sign-in answers 503 and
# password sign-in keeps working.
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
# Force a transport: resend | smtp | stdout
# MOTOQUANT_EMAIL_BACKEND=

# ── Chat agent (POST /api/chat) ──────────────────────────────────────────────
# Provider: groq (default) | gemini | anthropic | deepseek | openrouter.
# Set the matching key; without one, chat answers "llm_not_configured".
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=          # optional override (default claude-sonnet-5-5)
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Per-IP chat turns per rolling 24 h — the bill fuse on whoever pays for the
# LLM key. 0 disables the cap (e.g. your own key or a local model).
# MOTOQUANT_CHAT_DAILY_LIMIT=200
# Trusted X-Forwarded-For hops for rate-limit keying. Unset = auto (1 on
# Render or behind a loopback/private-network proxy, else 0). See
# docs/SELF_HOSTING.md section 3g.
# MOTOQUANT_TRUSTED_PROXY_HOPS=
# Agent web lookup: brave | serper (+ key). Without a key a DuckDuckGo HTML
# fallback is used; MOTOQUANT_WEB_TOOLS=0 turns web access off entirely.
# SEARCH_PROVIDER=
# SEARCH_API_KEY=
# MOTOQUANT_WEB_TOOLS=1

# ── Abuse fuses ──────────────────────────────────────────────────────────────
# Per-IP rate limits on every compute-heavy route. Only disable for tests.
# MOTOQUANT_RATE_LIMIT=true

# ── Weather (live venue conditions) ─────────────────────────────────────────
# OPENWEATHERMAP_API_KEY=

# ── Observability (all opt-in) ───────────────────────────────────────────────
# Sentry error tracking — a no-op unless SENTRY_DSN is set.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_SEND_PII=false
# Server-side usage telemetry forwarding to PostHog. OPT-IN: nothing is sent
# anywhere unless POSTHOG_API_KEY is set (events are otherwise logged locally).
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# ── Free-tier hosting keep-warm (Render) ─────────────────────────────────────
# Self-ping so a sleeping free instance stays warm during the day. No-op unless
# RENDER_EXTERNAL_URL (set by Render) or this URL is present.
# MOTOQUANT_KEEPWARM_URL=
# MOTOQUANT_KEEPWARM_INTERVAL_S=420

# ── MCP server (motoquant-mcp) ───────────────────────────────────────────────
# MOTOQUANT_API_URL=https://motoquant-api.onrender.com
# MOTOQUANT_MCP_LOCAL=0
# MOTOQUANT_MCP_TIMEOUT=90
