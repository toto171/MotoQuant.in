{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "MotoQuant Pro",
  "version": "1.0.0-alpha.1",
  "identifier": "in.motoquant.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MotoQuant Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: blob: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Motorcycle drag-racing physics simulator",
    "longDescription": "MotoQuant Pro — The physics of faster. First-principles quarter-mile simulator for motorcycle drag racing, with a 290-bike catalog, 465-part mod library, 15-submodel physics engine, and data-driven build recommendations.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "externalBin": [
      "bin/motoquant-backend"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_OUTPUT_OF__cargo_tauri_signer_generate",
      "endpoints": [
        "https://github.com/da25mem5s02-debug/MotoQuant_v1/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
