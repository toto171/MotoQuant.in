{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "MotoQuant Pro",
  "version": "0.1.0",
  "identifier": "in.motoquant.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MotoQuant Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://motoquant-api.onrender.com; img-src 'self' data: blob: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Motorcycle drag-racing physics simulator",
    "longDescription": "MotoQuant Pro \u2014 The physics of faster. A licensed desktop client for the MotoQuant quarter-mile simulation service. Sign in to run first-principles drag simulations, build optimization, and data-driven recommendations against the hosted MotoQuant engine. Requires an active MotoQuant account.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://motoquant.in/desktop/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "PLACEHOLDER_DO_NOT_SHIP__RUN_tauri_signer_generate_AND_PASTE_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
