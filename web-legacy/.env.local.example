# MotoQuant Pro — Next.js Environment Variables
# Copy this file to .env.local and fill in your values

# URL of the deployed Streamlit simulation app
# e.g. https://app.motoquant.in or https://your-app.railway.app
NEXT_PUBLIC_STREAMLIT_URL=https://app.motoquant.in

# URL of the deployed FastAPI backend (used by SimulatorWidget)
NEXT_PUBLIC_API_URL=https://api.motoquant.in
