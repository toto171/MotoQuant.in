# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.venv/
venv/

# Tests, lint and coverage
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Databases. The seeded catalog motoquant.db is tracked deliberately (the
# Docker image and the tests use it); any other database, and SQLite's
# journal and backup files, stay out.
*.db
!/motoquant.db
*.db-shm
*.db-wal
*.db.bak*

# Model artifacts: only the shipped ones under artifacts/ are tracked.
*.npz
*.pkl
!artifacts/**/*.npz
!artifacts/**/*.pkl

# Web
node_modules/
.next/
.next-*/
.vercel/

# Rust
rust/target/

# Scraper cache (scripts/scrape_bike_specs.py)
scrape_cache/

# Secrets and local configuration: never commit.
# The templates (.env.example, web/.env.local.example) stay tracked.
.env
.env.*
!.env.example
!*.example
.npmrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json
*creds*.env
preflight.env
tokens.md
tokens.md.*
TOKENS_UPDATE_*.md
*.token
*.tokens
secrets.local
.motoquant-secrets/

# Editors, OS and tool state
.vscode/
.idea/
.claude/
*.swp
*~
.DS_Store
Thumbs.db

# Logs and leftovers
*.log
logs/
tmp/
*.orig
*.rej
*.bundle
*.zip
