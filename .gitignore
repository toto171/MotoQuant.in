# Ruff cache
.ruff_cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# ...but these first-party `lib/` folders under the JS/TS frontends are
# source, not Python build artifacts, and must be tracked.
!web/lib/
!web/lib/**
!desktop/src/lib/
!desktop/src/lib/**
parts/
# motoquant/parts/ is first-party source (compatibility engine), not a
# Python build artifact. Must be tracked — otherwise /api/parts with a
# bike_id filter 500s in production because the module isn't in the wheel.
!motoquant/parts/
!motoquant/parts/**
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.db-shm
*.db-wal
# Rotational DB backups (e.g. motoquant.db.bak.20260420) -- the suffix
# means the plain *.db rule doesn't catch them.
*.db.bak*
*.db-shm.bak*
*.db-wal.bak*
# Pre-rebuild safety copies (e.g. motoquant.db.before-rebuild_2026_05_03,
# tokens.md.before-rebuild). The suffix-after-extension form breaks the
# narrower *.db.bak* and *.db* globs above, so cover the whole class.
*.db.before-rebuild*
*.before-rebuild
*.before-rebuild_*
*.before-reseed
*.before-reseed_*

# Temporary files
.tmp
tmp/
*.temp

# Streamlit
.streamlit/

# FUSE temp files
.fuse_hidden*

# Trained model artifacts (too large for git)
*.pkl
*.npz
# …except the shipped baseline surrogate under artifacts/, so the CLI works
# out-of-the-box without a 12-minute training run.
!artifacts/**/*.npz
!artifacts/**/*.pkl
# Progress-bar log from the generate command — keep out of git.
artifacts/**/*.log

# Backup archives
*.zip

# Node
node_modules/
.next/

# Scrape checkpoints
*_checkpoint.json

# Pytest cache copies
pytest-cache-files-*/
motoquant/parts/__pycache__/
__pycache__/

# Local secrets — never commit
# (contains GitHub PAT pasted in chat sessions, env files, etc.)
# User should revoke any PAT here at github.com/settings/tokens
tokens.md
tokens.md.bak
*.tokens
*.token
secrets.local
.env.local

# ── Reliability stack hardening (2026-05-04) ──────────────────────────────
# Belt-and-braces — these paths SHOULD never be inside the repo (they live
# outside the FUSE mount or in /tmp), but defence-in-depth in case anyone
# ever copies them in.
.motoquant-secrets/
git-creds.env
preflight.env
mq-session-*/
*.session.lock

# ── Added 2026-05-07: post-cleanup hardening ──
# Runtime session logs — never track
logs/
logs/*.log

# One-time token-merge files (transient, manual cleanup after paste)
TOKENS_UPDATE_*.md

# Defensive: file accidentally created when bash redirect target name
# collides with the 'claude' command (sed-mangle artifact, see 2c4986d)
/claude

# Cowork/Claude local worktree + agent state (never commit)
.claude/

# ── Added 2026-06-12: repo-hygiene pass ──
# Git bundles (crash-insurance snapshots made by sandbox sessions — never track)
*.bundle
# Stray build/session logs at any depth (b1.log, build*.log, npmi.log class —
# /tmp scratch that occasionally gets copied into the repo). No .log file is
# tracked today (verified via `git ls-files '*.log'`), so this swallows nothing.
*.log
# Patch-tool droppings
*.orig
*.rej

# Scrapling toolkit raw-HTML disk cache (scripts/scrape_bike_specs.py)
scrape_cache/

# Rust core build output
rust/target/

# ── Added 2026-10-24: open-source secret hygiene ──
# Environment files at any depth. The committed templates (.env.example,
# web/.env.local.example) stay tracked via the negations below.
.env
.env.*
!.env.example
!*.example
# Keys, certificates and credential exports
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json
# npm auth tokens live in .npmrc
.npmrc
# Vercel CLI project link (org/project ids + cached env pulled by `vercel pull`)
.vercel/
# Test / coverage output
coverage.xml
.hypothesis/
