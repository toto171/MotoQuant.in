# Copy this file to .env.oracle ON THE VM (never commit the real one — it's
# gitignored) and fill in whichever of these you want to enable. All are
# optional; the simulator + catalog endpoints work with none of them set.
#
#   cp .env.oracle.example .env.oracle
#   nano .env.oracle
#   docker compose up -d

# Chat agent (motoquant/llm/*) — set ONE provider key
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Chat agent web-lookup upgrade (optional; DuckDuckGo HTML fallback is used
# without these)
# SEARCH_PROVIDER=brave
# SEARCH_API_KEY=

# Error tracking
# SENTRY_DSN=

# Auth / accounts (required before enabling real user accounts)
# JWT_SECRET=

# Payments (only needed once MOTOQUANT_BILLING_ENFORCE=true)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
