+def _engine_key(spec: BikeSpec):
+    if not (spec.manufacturer and spec.bore_mm and spec.stroke_mm and spec.cylinders):
+        return None
+    return (
+        spec.manufacturer.lower().strip(),
+        round(float(spec.bore_mm), 1),
+        round(float(spec.stroke_mm), 1),
+        int(spec.cylinders),
+        int(getattr(spec, "stroke_type", 4) or 4),
+    )
+
+
+def _direct_primary(spec: BikeSpec):
+    """(value, source, detail) from the spec itself or its Tier-1 entry, else None."""
+    if spec.primary_ratio:
+        return float(spec.primary_ratio), "spec", "spec primary_ratio"
+    entry = find_tier1_entry(spec.manufacturer, spec.model_name, spec.year_from)
+    if entry is None or "primary" not in entry or entry.get("primary_implausible"):
