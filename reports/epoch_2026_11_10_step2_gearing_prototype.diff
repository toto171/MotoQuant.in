+# ────────────────────────────────────────────────────────
+# Primary-reduction resolution (epoch 2026-11-10)
+# ────────────────────────────────────────────────────────
+# Where a bike's primary reduction comes from, best evidence first:
+#
+#   spec               the spec carries primary_ratio
+#   tier1              a named gear_ratios entry (flagged primary_verified when
+#                      it has a service-manual citation; "tier1-unverified" when
+#                      flagged primary_unverified)
+#   sibling            INFERRED: another catalog bike with the same engine
+#                      (manufacturer, bore x stroke, cylinders, stroke cycle)
+#                      has a spec / Tier-1 primary - the same engine has the
+#                      same primary gear pair. Applied in the same domain as
+#                      the class rule (geared 4-stroke, <= 2 cyl, < 700 cc).
+#   class-inferred     INFERRED: geared 4-stroke, <= 2 cylinders, < 700 cc and
+#                      nothing better - displacement-interpolated between the
+#                      repo's service-manual primaries
+#                      (gear_ratios.class_primary_ratio)
+#   tier2-generic      the category default (a litre inline-four value); what
+#                      every bike without a spec / Tier-1 primary used to get
+#
+# "sibling" and "class-inferred" are estimates, never specifications. They are
+# labelled as such here, in the gearing plausibility report, and in the
+# data_provenance table (source_type "estimation").
+
+PRIMARY_SOURCE_INFERRED = ("sibling", "class-inferred")
+
+_SIBLING_INDEX: dict | None = None
