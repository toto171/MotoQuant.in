{
  "version": 2,
  "env": {
    "NEXT_PUBLIC_API_URL": ""
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://motoquant-api.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/wake",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/wake",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/wake",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/wake",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/wake",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/wake",
      "schedule": "0 18 * * *"
    }
  ]
}
